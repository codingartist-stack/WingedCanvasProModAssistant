{
  "manifest_version": 3,
  "name": "Winged Canvas Pro Mod Assistant",
  "version": "4.6",
  "description": "Advanced helper dashboard for Winged Canvas YouTube stream moderators.",
  "permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "all_frames": true
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png"
    },
    "default_title": "Winged Canvas Pro Mod Assistant"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/hero-canvas-reflect.png",
        "images/winged-canvas-nerd-glasses.png"
      ],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
